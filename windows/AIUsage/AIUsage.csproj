<Project Sdk="Microsoft.NET.Sdk">

  <!-- 화면 위에 떠 있는 창. 설치 없이 도는 단일 실행 파일(AIUsage.exe)로 낸다. 맥에서 빌드: zsh windows/build.sh -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AIUsage</RootNamespace>
    <AssemblyName>AIUsage</AssemblyName>
    <ApplicationIcon>AIUsage.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>AI 사용량</Product>
    <AssemblyTitle>AI 사용량</AssemblyTitle>
    <Description>Claude·ChatGPT(Codex) 사용 한도를 화면 위에 띄워 둔다</Description>
    <Version>1.4.3</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/Usage.cs" />
    <Compile Include="../Shared/Sessions.cs" />
    <!-- 화면 글자 번역(맥 판과 같은 파일) -->
    <EmbeddedResource Include="../../i18n/strings.json" LogicalName="strings.json" />
    <EmbeddedResource Include="AIUsage.ico" LogicalName="AIUsage.ico" />
    <!-- 설치할 때 꺼내 둘 상태 표시줄 프로그램(build.sh 가 먼저 만든다) -->
    <EmbeddedResource Include="../AIUsageStatus/publish/AIUsageStatus.exe" LogicalName="AIUsageStatus.exe" />
  </ItemGroup>

  <!-- 상태 표시줄 프로그램 없이 만들어지지 않게 막는다 -->
  <Target Name="RequireStatusExe" BeforeTargets="BeforeBuild" Condition="!Exists('../AIUsageStatus/publish/AIUsageStatus.exe')">
    <Error Text="상태 표시줄 프로그램이 없습니다. zsh windows/build.sh(맥) 또는 windows/build.ps1(Windows) 로 만드세요." />
  </Target>

</Project>
